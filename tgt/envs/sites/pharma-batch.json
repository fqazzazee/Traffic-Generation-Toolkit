  "findings": [
    {"id": "recipe-write-from-lims", "title": "Recipe parameters written to a PLC from a corporate host", "severity": "critical", "category": "unauthorized-write", "hosts": ["LIMS01", "PLC-GRAN-02"], "flows": [{"client": "LIMS01", "server": "PLC-GRAN-02", "proto": "enip-write"}], "detail": "LIMS01 on the corporate LAN writes GR102_RCP.* recipe tags straight into the granulation controller PLC-GRAN-02 (Logix Write Tag), outside the batch server and engineering station and without a GxP audit event."},
    {"id": "shared-service-account", "title": "Shared service account on the recipe share", "severity": "medium", "category": "shared-account", "hosts": ["BATCH01", "MES01", "HIST01", "LIMS01", "OPS-HMI01", "OPS-HMI02", "OPS-HMI03", "RECIPE-FS"], "flows": [{"client": "BATCH01", "server": "RECIPE-FS", "proto": "smb-logon"}, {"client": "MES01", "server": "RECIPE-FS", "proto": "smb-logon"}, {"client": "HIST01", "server": "RECIPE-FS", "proto": "smb-logon"}, {"client": "LIMS01", "server": "RECIPE-FS", "proto": "smb-logon"}, {"client": "OPS-HMI01", "server": "RECIPE-FS", "proto": "smb-logon"}], "detail": "Seven hosts log on to \\\\RECIPE-FS\\Recipes$ as PHARMA\\svc_batch (user name visible in the NTLMSSP exchange), so recipe-file changes cannot be attributed to a person; only ENG01 uses a named account."},
    {"id": "corp-to-ot-bypassing-dmz", "title": "Corporate host reaches plant operations without the DMZ", "severity": "medium", "category": "cross-zone-access", "hosts": ["LIMS01", "MES01", "RECIPE-FS"], "flows": [{"client": "LIMS01", "server": "MES01", "proto": "https"}, {"client": "LIMS01", "server": "RECIPE-FS", "proto": "smb-logon"}], "detail": "LIMS01 talks HTTPS to MES01 and SMB to RECIPE-FS in PLANT-OPS directly, while QA users reach MES01 through JUMP01 and the historian is replicated to HIST-DMZ."}
  ]
