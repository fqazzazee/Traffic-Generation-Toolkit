    {"id": "flat-station-network", "title": "Flat station network at MS5", "severity": "medium", "category": "segmentation", "hosts": ["MS5-OFFICE", "MS5-FC", "MS5-PLC", "MS5-RTU"], "flows": [{"client": "MS5-OFFICE", "server": "MS5-FC", "proto": "modbus"}, {"client": "MS5-OFFICE", "server": "DC01", "proto": "kerberos"}, {"client": "MS5-OFFICE", "server": "FILE01", "proto": "smb"}], "detail": "The MS5 office PC shares one LAN with the PLC, flow computer and RTU, polls the flow computer itself and talks to corporate IT through the same VSAT NAT."},
