  "findings": [
    {"id": "eol-rtu-behind-realcom", "title": "End-of-life RTU reached through a RealCOM virtual COM port from a Windows 7 HMI", "severity": "high", "category": "legacy-device", "hosts": ["HMI-BLR01", "NPORT-BLR1"], "flows": [{"client": "HMI-BLR01", "server": "NPORT-BLR1", "proto": "realcom"}, {"client": "HMI-BLR01", "server": "NPORT-BLR1", "proto": "realcom-cmd"}], "detail": "The boiler RTU (SCADAPack 334E, end of life) has no IP of its own: the Windows 7 HMI polls it as Modbus RTU through the NPort 5150's RealCOM data channel (TCP 950) and command channel (TCP 966). It shows up only as the gateway's traffic."},
    {"id": "raw-serial-tunnel", "title": "Unauthenticated raw-TCP serial tunnels carry drive setpoint writes and relay polls", "severity": "high", "category": "unauthorized-write", "hosts": ["NPORT-MCC1"], "flows": [{"client": "SCADA01", "server": "NPORT-MCC1", "proto": "modbus-rtu-tcp"}, {"client": "SCADA01", "server": "NPORT-MCC1", "proto": "dnp3-serial"}], "detail": "NPort ports 1 and 3 run in TCP-server mode with no IP filter: anyone reaching 10.170.10.21:4001 can send Modbus RTU writes (FC 6) to the four ACS580 drives, and 4003 talks DNP3 straight to the SEL-351S relays. No Modbus/TCP header, so a 502-only rule misses it."},
    {"id": "lorawan-udp-forwarder", "title": "LoRaWAN gateways forward over the unauthenticated Semtech UDP protocol across zones", "severity": "medium", "category": "cross-zone-access", "hosts": ["LORA-GW01", "LORA-GW02", "LNS01"], "flows": [{"client": "LORA-GW01", "server": "LNS01", "proto": "lorawan-udp"}, {"client": "LORA-GW02", "server": "LNS01", "proto": "lorawan-udp"}], "detail": "The gateways in the OT cell push sensor uplinks to the DMZ network server on 1700/udp (no authentication, no transport encryption, spoofable gateway EUI) instead of an authenticated Basics Station / TLS link."}
  ]
}
