  "findings": [
    {"id": "vnc-no-auth", "title": "Lift-station HMI exposed over VNC with no authentication", "severity": "high", "category": "insecure-remote-access", "hosts": ["LS04-HMI", "LS04-MODEM"], "flows": [{"client": "OPS-WS2", "server": "LS04-HMI", "proto": "vnc"}], "detail": "The LS04 Weintek panel's VNC server (security type None) is port-forwarded through the Digi modem; anyone reaching 10.250.0.14:5900 gets the pump-control screen."},
    {"id": "telnet-to-modem", "title": "Cleartext Telnet login to a cellular modem", "severity": "high", "category": "cleartext-credentials", "hosts": ["LS07-MODEM"], "flows": [{"client": "ENG01", "server": "LS07-MODEM", "proto": "telnet"}], "detail": "ENG01 logs in to the LS07 Moxa OnCell over Telnet with the factory admin/moxa credentials."},
    {"id": "default-snmp-community", "title": "Default SNMP community 'public' on the station modems", "severity": "medium", "category": "default-credentials", "hosts": ["LS01-MODEM", "LS02-MODEM", "LS03-MODEM", "LS04-MODEM", "LS05-MODEM", "LS06-MODEM", "LS07-MODEM", "LS08-MODEM"], "flows": [{"client": "OT-NMS", "server": "LS01-MODEM", "proto": "snmp"}, {"client": "OT-NMS", "server": "LS04-MODEM", "proto": "snmp"}, {"client": "OT-NMS", "server": "LS07-MODEM", "proto": "snmp"}], "detail": "Every modem answers SNMPv2c polls with community 'public' while the plant switches use a site community."},
    {"id": "eol-windows-hmi", "title": "End-of-life Windows XP HMI on the filter gallery", "severity": "high", "category": "legacy-os", "hosts": ["HMI-FILTER"], "flows": [{"client": "HMI-FILTER", "server": "HIST01", "proto": "smb"}], "detail": "HMI-FILTER runs Windows XP SP3 (SMBv1, MS17-010/MS08-067) and is not covered by EDR."},
    {"id": "eol-rtu", "title": "End-of-life SCADAPack 334E RTU at LS08", "severity": "low", "category": "legacy-device", "hosts": ["LS08-RTU"], "flows": [{"client": "SCADA01", "server": "LS08-RTU", "proto": "modbus"}], "detail": "The LS08 RTU is a discontinued SCADAPack 300-series unit polled over unauthenticated Modbus/TCP."}
  ]
