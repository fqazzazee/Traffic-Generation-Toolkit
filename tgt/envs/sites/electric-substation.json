    {"id": "goose-unexpected-publisher", "title": "GOOSE from a publisher not in the substation configuration", "severity": "high", "category": "rogue-device", "hosts": ["TESTSET-01"], "flows": [{"client": "RTAC01", "server": "TESTSET-01", "proto": "goose"}], "detail": "An OMICRON CMC test set left on the station bus publishes trip GOOSE (APPID 0x0001, gocbRef TESTSET01LD0/LLN0$GO$gcbTrip) that no IED's SCD subscription names."},
    {"id": "corp-relay-engineering", "title": "Relay engineering session from the corporate network", "severity": "high", "category": "cross-zone-access", "hosts": ["CORP-ENG-LT", "L1-SEL451"], "flows": [{"client": "CORP-ENG-LT", "server": "L1-SEL451", "proto": "sel-telnet"}], "detail": "A corporate-office laptop changes SEL-451 settings over Telnet across the WAN, bypassing SUB-JUMP."},
    {"id": "rogue-ptp-grandmaster", "title": "PTP grandmaster announced by an unknown device", "severity": "high", "category": "rogue-device", "hosts": ["PTP-ROGUE"], "flows": [{"client": "F2-REF615", "server": "PTP-ROGUE", "proto": "ptp-l2"}], "detail": "A Raspberry Pi running ptp4l announces itself as a GPS-locked grandmaster alongside the SEL-2488; IEDs that follow it misalign protection and SV timestamps."},
    {"id": "sel-default-passwords", "title": "SEL relays accessed with factory passwords over cleartext Telnet", "severity": "medium", "category": "default-credentials", "hosts": ["F1-SEL751", "T1-SEL487E", "L1-SEL451"], "flows": [{"client": "SUB-ENG", "server": "F1-SEL751", "proto": "sel-telnet"}, {"client": "CORP-ENG-LT", "server": "L1-SEL451", "proto": "sel-telnet"}], "detail": "ACC / 2AC logins send the factory OTTER / TAIL passwords in the clear."}
